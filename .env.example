########################################
# General
########################################

# Public base URL of this server (used to build shareable links, OAuth
# redirect URIs, and links inside emails)
BASE_URL=http://localhost:8000
ENV=development
PORT=8000

# Shown as the "문의하기" contact address across the site
SUPPORT_EMAIL=yojun313@postech.ac.kr

# Sign-up always requires an emailed 6-digit verification code.
# RESTRICT_SIGNUP_DOMAIN=true  -> only ALLOWED_EMAIL_DOMAIN addresses may register
# RESTRICT_SIGNUP_DOMAIN=false -> any email address may register
RESTRICT_SIGNUP_DOMAIN=true
ALLOWED_EMAIL_DOMAIN=postech.ac.kr

########################################
# Session / auth
########################################

# Random string, 32+ chars recommended. Signs the login session cookie.
SESSION_SECRET=change-me-to-a-long-random-string

########################################
# MongoDB
########################################

MONGO_URI=mongodb://localhost:27017
DB_NAME=commeet

########################################
# Google Calendar integration (optional)
#
# Only used for the "Connect Google Calendar" feature in Settings / Groups,
# NOT for login (login is always email+password). If left blank, calendar
# connection is simply hidden in the UI and everything else works normally.
#
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client type: Web application), enable the "Google Calendar API",
# and add {BASE_URL}/calendar/google/callback as an authorized redirect URI.
########################################

# Google Calendar 연동 전체 스위치. false로 두면 관련 기능이 동작하지 않고
# 화면에서도 관련 버튼·안내가 모두 사라집니다 (캘린더 페이지의 설정 버튼과
# 모달, 설정 페이지의 캘린더 연동 안내, 일정 페이지의 "캘린더로 자동 채우기",
# 랜딩/개인정보처리방침의 언급까지). 아래 자격증명이 비어 있으면 켜 두어도
# 자동으로 꺼집니다.
GOOGLE_CALENDAR_ENABLED=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/calendar/google/callback

########################################
# Mail sending (optional)
#
# Used to send sign-up verification codes and notification emails (someone
# responded, group invites, etc). If the chosen backend is not configured,
# emails are logged to the console instead - including the sign-up code, so
# local testing still works.
#
# MAIL_BACKEND picks how mail leaves the server:
#   gmail   - smtp.gmail.com:587 with an app password. Works from anywhere.
#             Needs MAIL_SENDER + MAIL_PASSWORD below.
#   postech - smtp.postech.ac.kr:25 unauthenticated relay. Needs NO password,
#             but ONLY works from an IP registered with the POSTECH mail admin
#             via '이메일 무인증 발송신청'. Registered IP: 141.223.145.21.
#             From any other host the relay answers
#             '421 4.3.2 Service not available'.
########################################

MAIL_BACKEND=gmail

# gmail backend: the Google account address + a Google "app password"
#   (Google Account > Security > 2-Step Verification > App passwords),
#   NOT your normal account password.
# postech backend: MAIL_SENDER is just the From address (any @postech.ac.kr
#   address is accepted) and MAIL_PASSWORD is ignored.
#   Defaults to commeet@postech.ac.kr when left blank.
MAIL_SENDER=
MAIL_PASSWORD=

# The postech relay is send-only, so point replies at a real mailbox.
MAIL_REPLY_TO=

# postech backend only - override if the relay host/port ever changes
MAIL_SMTP_HOST=smtp.postech.ac.kr
MAIL_SMTP_PORT=25
MAIL_STARTTLS=true

########################################
# Meeting records (학생지도비 신청서)
#
# Attendee names, meeting notes and receipt/signature images are personal
# data and are always encrypted at rest.
########################################

# Where encrypted record blobs are written. Blank = <project>/instance/records
# (already gitignored).
RECORD_STORAGE_DIR=

# Base64 Fernet key. Blank = derived from SESSION_SECRET, which works out of
# the box but means rotating SESSION_SECRET orphans existing records.
# Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RECORD_ENCRYPTION_KEY=

# 학생지도비 단가 (원/인). 참석자 소속별로 집행액을 자동 계산할 때 쓰입니다.
GUIDANCE_FEE_CSE=30000
GUIDANCE_FEE_MUUNJAE=15000

# 여러 명에게 한꺼번에 보낼 때 동시에 여는 SMTP 연결 수 (기본 4).
MAIL_MAX_CONNECTIONS=4

# 보내기 전에 수신 도메인이 메일을 받을 수 있는지 DNS(MX, 없으면 A)로 확인하고,
# 없는 도메인이면 발송을 건너뜁니다. 판단이 서지 않으면(타임아웃 등) 보냅니다.
# .local / .test / .invalid / example.com 같은 예약 도메인은 이 값과 무관하게
# 항상 차단됩니다 - 실제로 배달될 수 없는 이름이기 때문입니다.
MAIL_VERIFY_DOMAIN=true
MAIL_DNS_TIMEOUT=3
